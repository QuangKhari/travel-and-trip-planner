APP_NAME=Travela
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3310
DB_DATABASE=ai_trip_planner
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Giữ chỗ đơn chờ xác nhận (giờ) và số lần một tài khoản được dùng 1 mã giảm giá
BOOKING_HOLD_HOURS=48
COUPON_MAX_USES_PER_USER=1

# Ảnh upload (xem config/media.php)
MEDIA_DISK=public
MEDIA_PROOF_DISK=proofs
MEDIA_PUBLIC_ROOT=D:/travel-data/public
MEDIA_PRIVATE_ROOT=D:/travel-data/private

JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=10