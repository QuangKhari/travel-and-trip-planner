# Bản mẫu cho docker compose: cp .env.docker.example .env.docker rồi điền APP_KEY, mật khẩu, khóa.
# DB_HOST / REDIS_HOST / CACHE_STORE / SESSION_DRIVER / QUEUE_CONNECTION do docker-compose.yml đặt sẵn.
APP_NAME=Travela
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=travela
DB_USERNAME=travela
DB_PASSWORD=travela_secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Hàng đợi email (hóa đơn, xác nhận đơn, trả lời tư vấn): chạy thêm `php artisan queue:work` ở cửa sổ khác.
# Chính sách hủy / hoàn tiền (config/booking.php): đơn đã thanh toán hủy trên web khi còn >= N ngày (14+ ngày hoàn 100%, 7-13 ngày 50%)
BOOKING_PAID_CANCEL_MIN_DAYS=7
BOOKING_UNPAID_CANCEL_MIN_DAYS=1

# VNPay (config/vnpay.php). Sandbox: https://sandbox.vnpayment.vn/devreg/  — IPN URL khai báo với VNPay: {APP_URL}/thanh-toan/vnpay/ipn
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_HOLD_MINUTES=15
#VNPAY_RETURN_URL=https://<tunnel>.ngrok-free.app/thanh-toan/vnpay/ket-qua

# Giữ chỗ đơn chờ xác nhận (giờ) và số lần một tài khoản được dùng 1 mã giảm giá
BOOKING_HOLD_HOURS=48
COUPON_MAX_USES_PER_USER=1

# Ảnh upload (xem config/media.php)
MEDIA_DISK=public
MEDIA_PROOF_DISK=proofs
MEDIA_PUBLIC_ROOT=D:/travel-data/public
MEDIA_PRIVATE_ROOT=D:/travel-data/private

JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=10

DATA_ENCRYPTION_KEY=

SITE_NAME=Travel
SITE_EMAIL=
SITE_PHONE=
SITE_ADDRESS=
SITE_FACEBOOK=
SITE_YOUTUBE=
SITE_INSTAGRAM=

SITE_ZALO=0901234567
SITE_MESSENGER=ten-trang-facebook
DISCOVER_USER_AGENT=
DISCOVER_POI_PROVIDER=overpass
DISCOVER_POI_RADIUS=12000
GEOAPIFY_KEY=
OPEN_METEO_KEY=
# Trip Planner (xem README mục 4)
PLANNER_EXTERNAL=on
PLANNER_ROUTE_PROVIDER=haversine
#PLANNER_OSRM_URL=https://router.project-osrm.org
#PLANNER_TRAVEL_MODE=driving

# ---- La bàn: trợ lý AI của Trip Planner (config/ai.php) ----
# Tắt (false) thì Planner vẫn dùng đầy đủ: F1 đọc câu bằng luật, F2 ghép câu mẫu.
AI_PLANNER_ENABLED=false
# anthropic | openai | none (mặc định dùng chung RAG_LLM_DRIVER và khóa của RAG)
AI_DRIVER=
AI_MODEL_BRIEF=
AI_MODEL_EXPLAIN=
# để trống = dùng RAG_LLM_MODEL (openai) hoặc model mặc định trong config/ai.php
AI_MODEL_COPILOT=
# Gói dự phòng: model chính hết hạn mức (429) / quá tải / quá giờ thì gọi model này. Để trống = không dùng.
# Gemini tính hạn mức theo dự án + model: cùng khóa, model khác đã có hạn mức riêng.
AI_FALLBACK_MODEL=
# Chỉ đặt khi dự phòng ở dự án / nhà cung cấp khác:
AI_FALLBACK_KEY=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_DRIVER=
# Dự phòng lớp 2 (vd Cerebras): gọi khi cả model chính lẫn dự phòng 1 đều hết lượt / quá tải
AI_FALLBACK2_MODEL=
AI_FALLBACK2_KEY=
AI_FALLBACK2_BASE_URL=
AI_FALLBACK2_DRIVER=
# Hỏi đáp và F5 dùng chung chuỗi dự phòng (false = tắt riêng cho Hỏi đáp)
AI_FALLBACK_RAG=true
AI_DAILY_LIMIT=40
# openai-compatible không hỗ trợ json_schema thì đặt object
AI_OPENAI_JSON_MODE=schema
AI_PRICE_IN=
AI_PRICE_OUT=
AI_LOG_TEXT=false

# ---------------- Redis (B1, PF-01) ----------------
# Bật Redis cho cache, phiên đăng nhập, hàng đợi và khóa giữ chỗ (Cache::lock "avail:{id}"). MySQL vẫn là nguồn sự thật cho chỗ / đơn.
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# ---------------- Vận hành (PF-08, J1) ----------------
# LOG_STACK=json   -> log JSON một dòng, kèm requestId (dùng trong Docker)
# Chỉ khi đo tải, KHÔNG có tác dụng ở APP_ENV=production:
LOADTEST_NO_THROTTLE=false
QUERY_COUNT_HEADER=false
# Sau nginx / load balancer: IP proxy được tin (Docker đặt "*")
TRUSTED_PROXIES=127.0.0.1

# ---------------- A-13 danh sách đồ mang theo (AI, lùi về luật) ----------------
AI_FEATURE_PACKING=true
AI_MODEL_PACKING=

# ---------------- API du lịch (T-36…T-38) ----------------
# true = luôn dùng dữ liệu thử nghiệm (có nhãn). Đặt false khi đã có khóa thật.
TRAVEL_API_SIMULATE=true
TRAVEL_API_TIMEOUT_MS=5000
DUFFEL_TOKEN=
AERODATABOX_RAPIDAPI_KEY=
AERODATABOX_MONTHLY_UNITS=600
AVIATIONSTACK_KEY=
AVIATIONSTACK_MONTHLY_CALLS=100
GEOAPIFY_KEY=
